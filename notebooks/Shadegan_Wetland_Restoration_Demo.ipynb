# =====================================================
# Shadegan Wetland Restoration Framework
# Main Analysis Script - Google Earth Engine + Random Forest
# Spatially Explicit Decision Support System
# =====================================================

import ee
import geemap
import geopandas as gpd
from PIL import Image, ImageDraw, ImageFont
import matplotlib.pyplot as plt

# Initialize Google Earth Engine
ee.Initialize()

print("✅ Google Earth Engine initialized successfully!")

# ====================== 1. Define Study Area ======================
# Replace with your own AOI or asset if needed
aoi = ee.FeatureCollection("projects/pars-460214/assets/shadegan_aoi")  # یا geometry دلخواه

# ====================== 2. Load Input Assets ======================
priority_map = ee.Image("projects/pars-460214/assets/Restoration_Priority_ShadeGAN_Final")
land_cover_map = ee.Image("projects/pars-460214/assets/classified_2024")

# Load shapefiles for protected areas, rivers, water sources, etc.
protected_areas = geemap.shp_to_ee("hefazatshode.shp")          # Protected zones
fresh_water_sources = geemap.shp_to_ee("abeshirin.shp")
karoon_river = geemap.shp_to_ee("karoonriver.shp")
stressors = geemap.shp_to_ee("stressors.shp")                   # Pollution / human activity sources

print("✅ All input layers loaded successfully.")

# ====================== 3. Create Analytical Layers ======================
# Distance to water bodies (km)
distance_to_water = fresh_water_sources.distance().divide(1000).rename('distance_to_water_km')

# Distance to stressors (km)
distance_to_stressors = stressors.distance().divide(1000).rename('distance_to_stressors_km')

# Habitat sensitivity map (buffered protected areas)
habitat_sensitivity = protected_areas.buffer(500).union().rename('habitat_sensitivity')

# Water zoning map (fresh / brackish / seawater)
water_zoning_map = ee.Image("projects/pars-460214/assets/water_zoning_map")

# ====================== 4. Rule-based Optimal Strategy Map ======================
strategy_map = (
    priority_map
    .where(priority_map.eq(1).And(land_cover_map.eq(1)), 1)      # High priority + water → Conservation
    .where(priority_map.eq(2).And(land_cover_map.eq(2)), 2)      # Medium + reed bed → Re-vegetation
    .where(priority_map.eq(3), 3)                                 # Low priority → Water management
    .where(priority_map.eq(4), 4)                                 # Pollution control
    .where(priority_map.eq(5), 5)                                 # Full restoration
)

strategy_map = strategy_map.rename('optimal_strategy')

print("✅ Rule-based strategy map created.")

# ====================== 5. Prepare Data for Random Forest ======================
ml_input_stack = (
    priority_map
    .addBands(land_cover_map)
    .addBands(distance_to_water)
    .addBands(distance_to_stressors)
    .addBands(habitat_sensitivity)
)

input_properties = ['Restoration_Priority', 'classification', 'distance_to_water_km',
                    'distance_to_stressors_km', 'habitat_sensitivity']

# Training points (stratified sample)
training_points = ml_input_stack.updateMask(strategy_map.gt(0)).stratifiedSample(
    numPoints=2500,
    classProperty='optimal_strategy',
    scale=30,
    seed=42
)

# Train Random Forest Classifier
rf_classifier = ee.Classifier.smileRandomForest(numberOfTrees=50).train(
    features=training_points,
    classProperty='optimal_strategy',
    inputProperties=input_properties
)

# Classify the entire area
optimal_strategy_map = ml_input_stack.select(input_properties).classify(rf_classifier).rename('optimal_strategy')

print("✅ Random Forest model trained successfully (50 trees).")

# ====================== 6. Export Results ======================
# Export final map as GeoTIFF
export_task = ee.batch.Export.image.toDrive(
    image=optimal_strategy_map,
    description='Optimal_Restoration_Strategy_ShadeGAN',
    folder='Shadegan_GEE_Exports',
    scale=30,
    maxPixels=1e13
)
export_task.start()

print("🚀 Export task started to Google Drive!")

# Optional: Add legend and export visual PNG (using geemap or PIL)
print("\n🎉 Shadegan Wetland Restoration Analysis completed successfully!")
